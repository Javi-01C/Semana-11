def _merge(arr, inicio, medio, fin):
    izquierda = arr[inicio:medio + 1]
    derecha = arr[medio + 1:fin + 1]
    i = 0; j = 0; k = inicio
    while i < len(izquierda) and j < len(derecha):
        val_izq = izquierda[i][0] if isinstance(izquierda[i], (tuple, list)) else izquierda[i]
        val_der = derecha[j][0] if isinstance(derecha[j], (tuple, list)) else derecha[j]
        if val_izq <= val_der:
            arr[k] = izquierda[i]; i += 1
        else:
            arr[k] = derecha[j]; j += 1
        k += 1
    while i < len(izquierda):
        arr[k] = izquierda[i]; i += 1; k += 1
    while j < len(derecha):
        arr[k] = derecha[j]; j += 1; k += 1

def _merge_sort_rec(arr, inicio, fin):
    if inicio >= fin: return
    medio = (inicio + fin) // 2
    _merge_sort_rec(arr, inicio, medio)
    _merge_sort_rec(arr, medio + 1, fin)
    _merge(arr, inicio, medio, fin)

def merge_sort(A):
    """Implementación de Merge Sort Estable de la S9"""
    if len(A) > 1:
        _merge_sort_rec(A, 0, len(A) - 1)


def elegir_pivote_mediana3(A, izq, der):
    medio = (izq + der) // 2
    val_izq = A[izq][0] if isinstance(A[izq], (tuple, list)) else A[izq]
    val_med = A[medio][0] if isinstance(A[medio], (tuple, list)) else A[medio]
    val_der = A[der][0] if isinstance(A[der], (tuple, list)) else A[der]
    if val_izq > val_med: A[izq], A[medio] = A[medio], A[izq]
    if val_izq > val_der: A[izq], A[der] = A[der], A[izq]
    if val_med > val_der: A[medio], A[der] = A[der], A[medio]
    A[medio], A[der] = A[der], A[medio]

def particionar_lomuto(A, izq, der):
    pivote = A[der][0] if isinstance(A[der], (tuple, list)) else A[der]
    i = izq - 1
    for j in range(izq, der):
        val_j = A[j][0] if isinstance(A[j], (tuple, list)) else A[j]
        if val_j <= pivote:
            i += 1
            A[i], A[j] = A[j], A[i]
    A[i + 1], A[der] = A[der], A[i + 1]
    return i + 1

def _quick_sort_rec(A, izq, der):
    if izq < der:
        elegir_pivote_mediana3(A, izq, der)
        p = particionar_lomuto(A, izq, der)
        _quick_sort_rec(A, izq, p - 1)
        _quick_sort_rec(A, p + 1, der)

def quick_sort(A, izq=None, der=None):
    """Implementación de Quick Sort con Mediana de Tres de la S10"""
    if izq is None: izq = 0
    if der is None: der = len(A) - 1
    if len(A) > 1:
        _quick_sort_rec(A, izq, der)


