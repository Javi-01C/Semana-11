#  SECCIÓN 2 — BÚSQUEDA BINARIA (iterativa)
# ──────────────────────────────────────────────────────────────────────

def busqueda_binaria(A, objetivo):
    """
    Búsqueda binaria iterativa sobre A ordenado ascendentemente.
    Retorna el índice de una ocurrencia de objetivo, o -1 si no existe.
    PRECONDICIÓN: A debe estar ordenado.
    Complejidad: O(log n) tiempo, O(1) espacio.
    """
    # DECISIÓN: ¿Por qué usar mid = (izq + der) // 2 y no (izq + der) / 2?
    # [ Porque los índices de las posiciones de un arreglo tienen que ser números enteros.
    #      El operador / da un resultado con punto decimal (flotante), mientras que // trunca el resultado y nos da el número entero exacto que necesitamos.]

    izq = 0
    der = len(A) - 1

    while izq <= der:
        mid = izq + (der - izq) // 2
        valor = A[mid][0] if isinstance(A[mid], (tuple, list)) else A[mid]
        
        if valor == objetivo:
            return mid
        elif valor < objetivo:
            izq = mid + 1
        else:
            der = mid - 1

    return -1


def busqueda_primera_ocurrencia(A, objetivo):
    izq, der = 0, len(A) - 1
    resultado = -1
    while izq <= der:
        mid = izq + (der - izq) // 2
        valor = A[mid][0] if isinstance(A[mid], (tuple, list)) else A[mid]
        if valor == objetivo:
            resultado = mid
            der = mid - 1  # Forzamos confinamiento a la izquierda
        elif valor < objetivo:
            izq = mid + 1
        else:
            der = mid - 1
    return resultado


def busqueda_ultima_ocurrencia(A, objetivo):
    izq, der = 0, len(A) - 1
    resultado = -1
    while izq <= der:
        mid = izq + (der - izq) // 2
        valor = A[mid][0] if isinstance(A[mid], (tuple, list)) else A[mid]
        if valor == objetivo:
            resultado = mid
            izq = mid + 1  # Forzamos confinamiento a la derecha
        elif valor < objetivo:
            izq = mid + 1
        else:
            der = mid - 1
    return resultado


def buscar_rango(A, objetivo):
    """Retorna los límites (primero, último) en O(log n) eliminando la expansión lineal."""
    primera = busqueda_primera_ocurrencia(A, objetivo)
    if primera == -1:
        return (-1, -1)
    ultima = busqueda_ultima_ocurrencia(A, objetivo)
    return (primera, ultima)


