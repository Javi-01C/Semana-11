def busqueda_lineal(A, objetivo):
    """
    Recorre A de izquierda a derecha buscando objetivo.
    Retorna el índice de la primera ocurrencia, o -1 si no existe.
    No requiere que A esté ordenado.
    Complejidad: O(n) tiempo, O(1) espacio.
    """
    # DECISIÓN: ¿Por qué iterar con enumerate en lugar de range?
    # [ Porque enumerate nos da directamente tanto el índice como el valor del elemento en cada paso. 
    #     Esto hace que el código de Python sea más limpio, rápido de leer y evita estar escribiendo A[i] a cada rato]

    for indice, elemento in enumerate(A):
        valor = elemento[0] if isinstance(elemento, (tuple, list)) else elemento
        if valor == objetivo:
            return indice
    return -1

